// Cloudflare Workers 정적 자산: 빌드된 dist/ 를 Worker 스크립트 없이 그대로 서빙합니다.
// Workers Builds 가 site/ 에서 `npm run build` 뒤 `npx wrangler deploy` 를 실행합니다 (docs/site.md).
// `name` 은 대시보드의 Worker 이름과 같아야 합니다 — 다르면 빌드가 배포를 거부합니다.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pykorail",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Starlight 가 dist/404.html 을 만듭니다. 없는 경로에는 그것을 404 상태로 돌려줍니다.
    "not_found_handling": "404-page"
  }
}
