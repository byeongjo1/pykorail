---
// 스플래시 히어로. 왼쪽에 제목 · 설치 명령 · 버튼 · 패키지 현황, 오른쪽에 승차권을 둡니다.
// 승차권은 README 배너(Claude Design "pykorail Banner" 2a · 2b)의 것을 이미지가 아니라
// 마크업으로 다시 짠 그림이라 통째로 aria-hidden 입니다 — 안의 열차 · 좌석은 예시이고,
// 실제 값(버전 · 다운로드)은 승차권 밖 왼쪽 단에만 둡니다. 제목 · 태그라인 · 버튼은 평소처럼
// front matter 에서 옵니다.
import { LinkButton } from "@astrojs/starlight/components";
import { packageStats } from "../lib/stats";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};

const install = "pip install pykorail";

const { version, totalDownloads, python } = await packageStats();
const stats = [
  { label: "VERSION", value: version, href: "https://pypi.org/project/pykorail/" },
  {
    label: "TOTAL DOWNLOADS",
    value: totalDownloads === undefined ? undefined : new Intl.NumberFormat("ko-KR").format(totalDownloads),
  },
  { label: "PYTHON", value: python },
].filter((stat) => stat.value !== undefined);

// 배너의 바코드 막대 폭(px)을 그대로 옮겼습니다. 읽히는 값은 아니고 모양뿐입니다.
const bars = [
  3, 1.5, 4.5, 1.5, 1.5, 3, 6, 1.5, 3, 1.5, 4.5, 3, 1.5, 1.5, 3, 4.5, 1.5, 3, 1.5, 6, 1.5, 3, 3, 1.5, 4.5,
  1.5, 1.5, 3, 1.5, 4.5, 3, 1.5, 3, 1.5, 1.5, 4.5, 3, 1.5, 3, 1.5, 4.5, 1.5, 3, 1.5, 1.5, 3, 4.5, 1.5, 3, 1.5,
];
---

<div class="pk-hero">
  <div class="pk-grid">
    <div class="pk-copy">
      <p class="pk-label">UNOFFICIAL · PYTHON SDK</p>
      <h1 id="_top" data-page-title set:html={title} />
      {tagline && <p class="pk-tagline" set:html={tagline} />}
      <div class="pk-install">
        <code><span class="pk-prompt" aria-hidden="true">$</span>{install}</code>
        <button type="button" data-copy={install} aria-live="polite">복사</button>
      </div>
      {
        actions.length > 0 && (
          <div class="pk-actions">
            {actions.map(({ attrs, icon, link: href, text, variant }) => (
              <LinkButton {href} {variant} icon={icon?.name} {...attrs}>
                {text}
              </LinkButton>
            ))}
          </div>
        )
      }
      {
        stats.length > 0 && (
          <dl class="pk-stats">
            {stats.map((stat) => (
              <div>
                <dt class="pk-label">{stat.label}</dt>
                <dd>{stat.href ? <a href={stat.href}>{stat.value}</a> : stat.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <div class="pk-ticket" aria-hidden="true">
      <div class="pk-main">
        <div class="pk-row">
          <div class="pk-field">
            <span class="pk-label">DATE</span>
            <span class="pk-value">04/01</span>
          </div>
          <div class="pk-field pk-end">
            <span class="pk-label">DURATION</span>
            <span class="pk-value pk-sans">3시간 30분</span>
          </div>
        </div>
        <div class="pk-route">
          <div class="pk-station">
            <span class="pk-label">SEOUL</span>
            <span class="pk-city">서울</span>
            <span class="pk-clock">09:00</span>
          </div>
          <div class="pk-line">
            <span class="pk-train">KTX 101</span>
            <i class="pk-dash"></i>
            <i class="pk-arrow"></i>
          </div>
          <div class="pk-station pk-end">
            <span class="pk-label">BUSAN</span>
            <span class="pk-city">부산</span>
            <span class="pk-clock">12:30</span>
          </div>
        </div>
      </div>
      <div class="pk-perf"></div>
      <div class="pk-stub">
        <div class="pk-field">
          <span class="pk-label">CAR / SEAT</span>
          <span class="pk-value">03 · 7A</span>
        </div>
        <div class="pk-field">
          <span class="pk-label">CLASS</span>
          <span class="pk-value pk-sans">일반실</span>
        </div>
        <div class="pk-barcode">
          {bars.map((width) => <i style={`width:${width}px`} />)}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // 설치 명령 복사. 클립보드가 막힌 환경(비보안 컨텍스트 등)에서는 조용히 아무 일도 하지 않습니다 —
  // 명령은 그대로 보이고 드래그로 고를 수 있습니다.
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    const idle = button.textContent;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
      } catch {
        return;
      }
      button.textContent = "복사됨";
      setTimeout(() => (button.textContent = idle), 1600);
    });
  });
</script>

<style>
  /* 바깥 컨테이너가 2단/1단을 정하고, 승차권은 자기 폭을 기준(cqi)으로 안쪽 치수를 정합니다. */
  .pk-hero {
    container-type: inline-size;
    padding-block: clamp(1.5rem, 6vw, 4.5rem) clamp(1rem, 4vw, 3rem);
  }
  .pk-grid {
    display: grid;
    gap: clamp(2.5rem, 6cqi, 4rem);
    align-items: center;
  }

  .pk-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  h1 {
    margin: 1rem 0 0;
    font-size: clamp(2.125rem, 9cqi, 3.375rem);
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
    word-break: keep-all;
    text-wrap: balance;
  }
  .pk-tagline {
    margin: 1.125rem 0 0;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.125rem);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    word-break: keep-all;
    text-wrap: pretty;
  }
  .pk-install {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(100%, 24rem);
    box-sizing: border-box;
    margin-top: 1.75rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border-radius: 8px;
    background: var(--pk-ink);
    color: var(--pk-ink-invert);
  }
  .pk-install code {
    font: 500 0.9375rem / 1.4 var(--sl-font-mono);
    white-space: nowrap;
    background: none;
    color: inherit;
  }
  .pk-prompt {
    margin-inline-end: 0.625rem;
    opacity: 0.5;
    user-select: none;
  }
  .pk-install button {
    flex: none;
    padding: 0.375rem 0.75rem;
    border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    border-radius: 5px;
    background: transparent;
    color: inherit;
    font: 500 0.8125rem / 1.4 var(--sl-font);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .pk-install button:hover {
    background: color-mix(in srgb, currentColor 14%, transparent);
  }
  .pk-install button:focus-visible {
    outline: 2px solid var(--pk-accent);
    outline-offset: 2px;
  }
  .pk-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.25rem;
  }

  /* 패키지 현황. 승차권의 필드와 같은 모양(라벨 위, 값 아래)으로 가는 선 아래에 늘어놓습니다. */
  .pk-stats {
    align-self: stretch;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(1.5rem, 5cqi, 2.75rem);
    margin: 2rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--pk-hairline);
  }
  .pk-stats dd {
    margin: 0.375rem 0 0;
    font: 700 1.25rem / 1.2 var(--sl-font-mono);
    color: var(--sl-color-white);
  }
  .pk-stats a {
    color: inherit;
    text-decoration: none;
  }
  .pk-stats a:hover {
    color: var(--sl-color-text-accent);
  }

  .pk-ticket {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    background: var(--pk-surface);
    box-shadow: var(--pk-ticket-shadow);
    color: var(--pk-ink);
  }
  .pk-main {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 9cqi, 3rem);
    padding: clamp(1.5rem, 7.5cqi, 2.5rem);
  }
  .pk-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .pk-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .pk-end {
    align-items: flex-end;
  }
  .pk-value {
    font: 700 clamp(1.125rem, 4.6cqi, 1.5rem) / 1.2 var(--sl-font-mono);
    white-space: nowrap;
  }
  .pk-sans {
    font-family: var(--sl-font);
  }

  .pk-route {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 4cqi, 1.5rem);
  }
  .pk-station {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .pk-city {
    font-size: clamp(2.75rem, 13.5cqi, 4.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .pk-clock {
    margin-top: 0.25rem;
    font: 500 clamp(0.8125rem, 2.8cqi, 0.9375rem) / 1.2 var(--sl-font-mono);
    color: var(--pk-muted);
  }
  /* 점선은 역 이름 가운데 높이에 두고, 열차 번호는 그 위에 얹습니다 — 번호가 선을 가르지
     않아야 좁은 승차권에서도 점선이 끊기지 않습니다. */
  .pk-line {
    flex: 1;
    min-width: 0;
    position: relative;
    display: flex;
    align-items: center;
  }
  .pk-train {
    position: absolute;
    inset-inline: 0;
    bottom: calc(100% + 0.375rem);
    text-align: center;
    font: 500 clamp(0.75rem, 2.8cqi, 0.9375rem) / 1 var(--sl-font-mono);
    color: var(--pk-accent);
    white-space: nowrap;
  }
  .pk-dash {
    flex: 1;
    height: 2px;
    background-image: repeating-linear-gradient(90deg, var(--pk-ink) 0 10px, transparent 10px 18px);
  }
  .pk-arrow {
    width: 0;
    height: 0;
    border-block: 7px solid transparent;
    border-inline-start: 12px solid var(--pk-ink);
  }

  /* 절취선. 양 끝의 반원 홈은 페이지 바탕색 원으로 승차권을 파낸 것처럼 보이게 합니다. */
  .pk-perf {
    position: relative;
    border-top: 2px dashed var(--pk-hairline);
  }
  .pk-perf::before,
  .pk-perf::after {
    content: "";
    position: absolute;
    top: -17px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--pk-page);
  }
  .pk-perf::before {
    left: -16px;
  }
  .pk-perf::after {
    right: -16px;
  }

  .pk-stub {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 6cqi, 2.25rem);
    padding: clamp(1.25rem, 5.5cqi, 1.75rem) clamp(1.5rem, 7.5cqi, 2.5rem);
  }
  .pk-barcode {
    flex: 1;
    height: 2.75rem;
    display: flex;
    justify-content: flex-end;
    gap: 2px;
    overflow: hidden;
    /* 막대 50개의 폭 합이 꼬리표를 밀어 넓히지 않게, 남는 폭만 채우고 넘치면 잘립니다. */
    contain: inline-size;
  }
  .pk-barcode i {
    flex: none;
    background: var(--pk-ink);
  }

  @container (min-width: 54rem) {
    .pk-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
    h1 {
      font-size: min(5cqi, 3.375rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pk-install button {
      transition: none;
    }
  }
</style>
