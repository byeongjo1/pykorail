---
// 출발 안내판. 배너 시안 1b 의 표를 옮긴 것이고, 행은 README "빠른 시작" 의 출력 예시와 같습니다 —
// 그쪽 예시를 바꾸면 여기도 함께 바꾸세요.
const rows = [
  { train: "KTX 101", time: "09:00~12:30", special: true, general: true },
  { train: "KTX 103", time: "10:00~13:30", special: false, general: true },
  { train: "KTX 105", time: "11:00~14:35", special: true, general: false },
];
const seat = (open: boolean) => (open ? "가능" : "매진");
---

<div class="pk-board">
  <div class="pk-board-head" aria-hidden="true">
    <span>DEPARTURES</span>
    <span>2026-04-01</span>
  </div>
  <table>
    <caption>옆의 코드가 출력하는 조회 결과 예시</caption>
    <thead>
      <tr>
        <th scope="col">TRAIN</th>
        <th scope="col">TIME</th>
        <th scope="col" class="pk-via">ROUTE</th>
        <th scope="col">특실</th>
        <th scope="col">일반실</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row.train}</th>
            <td>{row.time}</td>
            <td class="pk-via">서울 → 부산</td>
            <td class={row.special ? "pk-open" : "pk-sold"}>{seat(row.special)}</td>
            <td class={row.general ? "pk-open" : "pk-sold"}>{seat(row.general)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .pk-board {
    container-type: inline-size;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.125rem clamp(1rem, 5cqi, 1.5rem) 0.5rem;
    /* 다크 테마에서는 판과 페이지 바탕이 거의 같은 색이라, 테두리가 판의 경계를 잡습니다. */
    border: 1px solid var(--pk-board-line);
    border-radius: 8px;
    background: var(--pk-board);
    color: var(--pk-board-ink);
  }
  .pk-board-head {
    display: flex;
    justify-content: space-between;
    font: 500 0.75rem / 1.3 var(--sl-font-mono);
    letter-spacing: 0.14em;
    color: var(--pk-board-muted);
  }
  /* 옆의 코드 블록만큼 판이 길어지면 남는 높이를 행들이 나눠 갖습니다. */
  table {
    flex: 1;
    width: 100%;
    border-collapse: collapse;
    font: 500 clamp(0.8125rem, 3.2cqi, 1rem) / 1.3 var(--sl-font-mono);
  }
  caption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  th,
  td {
    padding: 0.8rem 0;
    padding-inline-end: 0.75rem;
    text-align: start;
    font-weight: 500;
    white-space: nowrap;
    border-top: 1px solid var(--pk-board-line);
  }
  :is(th, td):last-child {
    padding-inline-end: 0;
    text-align: end;
  }
  thead th {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--pk-board-muted);
  }
  tbody th {
    color: var(--pk-board-train);
  }
  td.pk-via {
    font-family: var(--sl-font);
  }
  .pk-open {
    color: var(--pk-board-open);
  }
  .pk-sold {
    color: var(--pk-board-sold);
  }
  @container (max-width: 27rem) {
    .pk-via {
      display: none;
    }
  }
</style>
